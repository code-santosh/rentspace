<% layout("/layouts/boilerPlate") %>

    <body>
        <div class="col-7 offset-3">

            <h3 class="mt-3">
                <%=currListing.title%>
            </h3>
            <div class="mt-4">
                <div class="card listing-card p-1">
                    <img src="<%= currListing.image.url %>" class="card-img-top card-img" alt="listing image">
                    <p class="card-text">
                        <i>
                            Posted by: <%= currListing.owner.username %>
                        </i>
                    </p>
                    <p class="card-text">
                        <%=currListing.description%>
                    </p>
                    <p class="card-text">
                        <i class="fa-solid fa-money-bill-wave"></i>
                        &#8360;. <%=currListing.price.toLocaleString("en-NP")%> / night
                    </p>
                    <p>
                        <i class="fa-solid fa-location-dot"></i>
                        <%=currListing.location%>
                    </p>
                    <p>
                        <i class="fa-solid fa-flag"></i>
                        <%=currListing.country%>
                    </p>

                    <% if(currUser && currListing.owner.equals(currUser._id)){ %>
                        <div class="d-flex gap-2 mt-3 align-items-stretch">
                            <a href="/listings/<%= currListing._id %>/edit" class="btn btn-create h-100">Edit</a>
                            <form method="post" action="/listings/<%= currListing._id %>?_method=delete"
                                class="flex-fill h-100" style="margin:0;">
                                <button class="btn btn-create h-100">Delete</button>
                            </form>
                        </div>
                        <% } %>
                </div>
            </div>

        </div>

        <% if(currUser) { %>
            <div class="col-7 mb-3 offset-3">
                <hr>
                <h4>Leave a review</h4>
                <form method="post" action="/listings/<%= currListing.id%>/reviews" novalidate class="needs-validation">
                    <div class="mb-3 mt-3">
                        <label for="rating" class="form-label">Rating</label>
                        <fieldset class="starability-slot">
                            <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1"
                                checked aria-label="No rating." />
                            <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                            <label for="first-rate1" title="Terrible">1 star</label>
                            <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                            <label for="first-rate2" title="Not good">2 stars</label>
                            <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                            <label for="first-rate3" title="Average">3 stars</label>
                            <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                            <label for="first-rate4" title="Very good">4 stars</label>
                            <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                            <label for="first-rate5" title="Amazing">5 stars</label>
                        </fieldset>
                    </div>

                    <div class="mb-3 mt-3">
                        <label for="comment" class="form-label">Comment</label>
                        <textarea id="comment" rows="3" cols="60" name="review[comment]" class="form-control"
                            required></textarea>
                        <div class="invalid-feedback">comment can't be empty</div>
                    </div>
                    <button class="btn btn-dark">Submit</button>
                </form>
            </div>
            <% } %>

                <div class="col-7 offset-3">
                    <hr />
                    <p><b>All Reviews</b></p>
                    <div class="row">
                        <% for(review of currListing.reviews){ %>

                            <div class="col-md-6 mb-3">
                                <div class="card p-2 h-100 shadow-sm">
                                    <div class="card-body">
                                        <h5 class="card-title">
                                            @<%= review.author.username%>
                                        </h5>
                                        <p class="card-text starability-result" data-rating="<%= review.rating %>"></p>
                                        <p class="card-text">
                                            <%= review.comment %>
                                        </p>
                                        <% if(currUser && review.author.equals(currUser._id)){ %>
                                            <form class="mb-3" method="post"
                                                action="/listings/<%=currListing._id%>/reviews/<%=review._id%>?_method=delete">
                                                <button class="btn btn-outline-secondary btn-sm">delete</button>
                                            </form>
                                            <%}%>
                                    </div>
                                </div>
                            </div>

                            <%}%>
                    </div>
                </div>

    </body>